{
    "name": "jeremykenedy/laravel-https",
    "description": "Laravel Https is middleware to check for Secure HTTP requests. Laravel Https middleware providers can check and redirect if the user is not hitting the https url of your app/site or the request can be automatically redirected to a Secure Http (HTTPS) request.",
    "keywords": [
        "HTTPS Middleware",
        "Laravel Https",
        "Secure Http",
        "Https"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jeremy Kenedy",
            "email": "jeremykenedy@gmail.com"
        }
    ],
    "require": {
        "php": "^7.2|^8.0|^8.1|^8.2|^8.3"
    },
    "require-dev": {
        "laravel/framework": "^5.1 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "laravel/pint": "^1.32",
        "phpunit/phpunit": "^8.5 || ^9.6 || ^11.5 || ^12.5"
    },
    "autoload": {
        "psr-4": {
            "jeremykenedy\\LaravelHttps\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "jeremykenedy\\LaravelHttps\\LaravelHttpsServiceProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "jeremykenedy\\LaravelHttps\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:test": "pint --test"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
